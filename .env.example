TAKOMI_APP_NAME=Takomidx
TAKOMI_DATA_DIR=.takomi
TAKOMI_PREVIEW_DOMAIN=takomi.localhost
TAKOMI_RUNTIME_BACKEND=container
TAKOMI_EDITOR_TARGET=vscode

NEXT_PUBLIC_TAKOMI_AGENTD_BASE_URL=http://127.0.0.1:4000
NEXT_PUBLIC_TAKOMI_PREVIEW_DOMAIN=takomi.localhost

TAKOMI_AGENTD_HOST=127.0.0.1
TAKOMI_AGENTD_PORT=4000

# Required: Gemini API key (or GOOGLE_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here

# Required: Groq API key for LLM reviews
GROQ_API_KEY=your_groq_api_key_here

# Optional: Override the embedding model
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional: Override the default model
# REVIEW_MODEL_NAME=moonshotai/kimi-k2-instruct-0905

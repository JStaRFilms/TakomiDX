{
  "extends": "@takomi/tsconfig/node.json",
  "compilerOptions": {
    "baseUrl": ".",
    "types": [
      "node",
      "vscode"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [

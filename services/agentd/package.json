{
  "name": "@takomi/agentd",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean --out-dir dist",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@takomi/contracts": "workspace:*"
  },
  "devDependencies": {
    "@takomi/tsconfig": "workspace:*",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3"
  }
}
